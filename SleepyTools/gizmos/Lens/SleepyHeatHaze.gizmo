  xpos 484
  ypos 291
 }
set N_Dot_Dot_Dot_Field_5_6_7 [stack 0]
push $N_Dot_Dot_Dot_Input1_1_2_3
 Copy {
  inputs 2
  from0 rgba.red
  to0 forward.u
  from1 rgba.green
  to1 forward.v
  name UVCopy
  xpos 520
  ypos 288
 }
set N_UVCopy [stack 0]
 IDistort {
  inputs 1
  channels rgba
  uv forward
  uv_scale 1
  name Distort
  xpos 520
  ypos 360
 }
set N_Distort [stack 0]
 Remove {
  inputs 1
  channels forward
  name RemoveUV
  xpos 520
  ypos 432
 }
set N_RemoveUV [stack 0]
 Dot {
  inputs 1
  name Dot_RemoveUV_8
  xpos 554
  ypos 507
 }
set N_Dot_RemoveUV_8 [stack 0]
push $N_Field
 Expression {
  inputs 1
  expr0 "r/max(parent.strength,1e-6)*0.5+0.5"
  expr1 "g/max(parent.strength,1e-6)*0.5+0.5"
  expr2 0.5
  name FieldView
  xpos 330
  ypos 288
 }
set N_FieldView [stack 0]
 Dot {
  inputs 1
  name Dot_FieldView_9
  xpos 364
  ypos 579
 }
set N_Dot_FieldView_9 [stack 0]
push $N_Dot_RemoveUV_8
push $N_Input1
 Dissolve {
  inputs 2
  which {{parent.mix}}
  name SleepyMix
  xpos 0
  ypos 504
 }
set N_SleepyMix [stack 0]
push $N_Dot_FieldView_9
push $N_SleepyMix
 Switch {
  inputs 2
  which {{parent.view}}
  name ViewSwitch
  xpos 0
  ypos 576
 }
set N_ViewSwitch [stack 0]
 Output {
