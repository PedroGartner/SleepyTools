#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0xc98a3aff
 inputs 2
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(1) is not None)\n"
 help "Heat haze: animated noise distortion that rises over time. Use the mask input (alpha) to limit it, e.g. above a road or behind an exhaust. Without a mask it covers the frame."
 addUserKnob {20 hh l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy HeatHaze</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens</font><br><font color=\"#a8a8a8\">Rising, boiling noise distortion, optionally masked.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {7 strength l "strength (px)" R 0 30}
 strength 4
 addUserKnob {7 size l "ripple size" R 2 200}
 size 30
 addUserKnob {7 speed l "boil speed" t "How fast the pattern changes." R 0 0.5}
 speed 0.08
 addUserKnob {7 rise l "rise (px/frame)" t "Upward drift of the pattern." R -10 10}
 rise 2
 addUserKnob {3 octaves}
 octaves 3
 addUserKnob {26 ""}
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {6 invert l "invert mask" -STARTLINE}
 addUserKnob {4 view M {Result "Distortion field"}}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy HeatHaze</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>image</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>optional: where the haze is</td></tr></table><br><b>How it works</b><br>Heat haze: animated noise distortion that rises over time. Use the mask input (alpha) to limit it, e.g. above a road or behind an exhaust. Without a mask it covers the frame."}
}
 BackdropNode {
  inputs 0
  name BD_Noise_field
  tile_color 0x4f3d26ff
  label "Noise field"
  note_font_size 24
  xpos 300
  ypos 22
  bdwidth 140
  bdheight 308
  z_order 0
 }
 BackdropNode {
  inputs 0
  name BD_Distort
  tile_color 0x4f3d26ff
  label "Distort"
  note_font_size 24
  xpos 490
  ypos 238
  bdwidth 140
  bdheight 236
  z_order 1
 }
 Input {
  inputs 0
  name Input1
  xpos 0
  ypos 0
 }
set N_Input1 [stack 0]
 Dot {
  inputs 1
  name Dot_Input1_1
  xpos 34
  ypos 39
 }
set N_Dot_Input1_1 [stack 0]
 Dot {
  inputs 1
  name Dot_Dot_Input1_1_2
  xpos 364
  ypos 39
 }
