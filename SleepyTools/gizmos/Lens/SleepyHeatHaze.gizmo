  xpos 554
  ypos 39
 }
set N_Dot_Dot_Dot_Input1_1_2_3 [stack 0]
push $N_Dot_Dot_Input1_1_2
 Noise {
  inputs 1
  output {rgba.red -rgba.green -rgba.blue -rgba.alpha}
  cliptype none
  replace true
  size {{parent.size}}
  zoffset {{frame*parent.speed}}
  octaves {{parent.octaves}}
  translate {0 {-frame*parent.rise}}
  name NoiseU
  xpos 330
  ypos 72
 }
set N_NoiseU [stack 0]
 Noise {
  inputs 1
  output {-rgba.red rgba.green -rgba.blue -rgba.alpha}
  cliptype none
  replace true
  size {{parent.size}}
  zoffset {{frame*parent.speed+37.3}}
  octaves {{parent.octaves}}
  translate {0 {-frame*parent.rise}}
  name NoiseV
  xpos 330
  ypos 144
 }
set N_NoiseV [stack 0]
 Input {
  inputs 0
  number 1
  name mask
  xpos 140
  ypos 144
 }
set N_mask [stack 0]
 Dot {
  inputs 1
  name Dot_mask_4
  xpos 174
  ypos 219
 }
set N_Dot_mask_4 [stack 0]
push $N_NoiseV
 MergeExpression {
  inputs 2
  expr0 "(Br-0.5)*2*parent.strength*(parent.use_mask ? (parent.invert ? 1-clamp(Aa) : clamp(Aa)) : 1)"
  expr1 "(Bg-0.5)*2*parent.strength*(parent.use_mask ? (parent.invert ? 1-clamp(Aa) : clamp(Aa)) : 1)"
  expr2 0
  name Field
  xpos 330
  ypos 216
 }
set N_Field [stack 0]
 Dot {
  inputs 1
  name Dot_Field_5
  xpos 364
  ypos 255
 }
set N_Dot_Field_5 [stack 0]
 Dot {
  inputs 1
