#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0xc98a3aff
 help "Lens realism in one node: distortion, chromatic aberration, edge softening and vignette. Each part is skipped when its amount is 0.\n\nDistortion and CA are pixel offsets applied with IDistort (red, green and blue separately), measured from the lens centre."
 addUserKnob {20 lk l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy LensKit</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens</font><br><font color=\"#a8a8a8\">Distortion, chromatic aberration, edge softening and vignette in one node.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {26 s1 l "<b>Distortion</b>"}
 addUserKnob {7 distortion t "Radial distortion (k1). Positive and negative bend lines in opposite directions." R -0.3 0.3}
 addUserKnob {7 distortion2 l "distortion k2" t "Second-order term, mostly affects the corners." R -0.3 0.3}
 addUserKnob {12 lens_center l "centre offset" t "Lens centre offset from the frame centre, in pixels."}
 addUserKnob {26 s2 l "<b>Chromatic aberration</b>"}
 addUserKnob {7 ca l "CA amount (%)" t "Red and blue are scaled in opposite directions by this percentage at the frame edge." R -2 2}
 ca 0.15
 addUserKnob {26 s3 l "<b>Softening</b>"}
 addUserKnob {7 soften l "edge softness" t "Blur size reached at the corners." R 0 10}
 addUserKnob {7 soften_falloff l "softness falloff" t "Higher = sharp area extends further out." R 0.5 6}
 soften_falloff 2
 addUserKnob {26 s4 l "<b>Vignette</b>"}
 addUserKnob {7 vignette l "vignette amount" R 0 1}
 addUserKnob {7 vig_falloff l "vignette falloff" R 0.5 6}
 vig_falloff 2
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy LensKit</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>image</td></tr></table><br><b>How it works</b><br>Lens realism in one node: distortion, chromatic aberration, edge softening and vignette. Each part is skipped when its amount is 0.<br><br>Distortion and CA are pixel offsets applied with IDistort (red, green and blue separately), measured from the lens centre."}
}
