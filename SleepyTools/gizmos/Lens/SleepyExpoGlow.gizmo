version 13.2 v4
Gizmo {
 tile_color 0xc98a3aff
 help "Exponential glow: 8 stacked blurs, each twice the size of the last, with weights falling off by 'falloff'. Gives the long natural tail that a single Glow can't.\n\nThe threshold works on luminance, so highlight colour is kept."
 addUserKnob {20 eg l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy ExpoGlow</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens</font><br><font color=\"#a8a8a8\">Eight stacked blurs with an exponential falloff for a natural long-tailed glow.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {7 threshold t "Only light above this luminance glows." R 0 10}
 threshold 1
 addUserKnob {7 size t "Size of the smallest blur. Each layer doubles it." R 0.5 20}
 size 3
 addUserKnob {7 falloff t "Weight ratio between layers. Higher = longer, wider tail." R 0.1 1}
 falloff 0.6
 addUserKnob {7 exposure l "exposure (stops)" R -6 6}
 addUserKnob {18 tint}
 tint {1 1 1}
 addUserKnob {7 saturation R 0 2}
 saturation 1
 addUserKnob {6 glow_only l "glow only" +STARTLINE}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy ExpoGlow</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Lens &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>image</td></tr></table><br><b>How it works</b><br>Exponential glow: 8 stacked blurs, each twice the size of the last, with weights falling off by &#x27;falloff&#x27;. Gives the long natural tail that a single Glow can&#x27;t.<br><br>The threshold works on luminance, so highlight colour is kept."}
}
