#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 help "Edge extend (push-pull).\n\nErodes the matte to a clean core, then pushes the core's colour outward to infinity, so semi-transparent edges carry clean foreground colour instead of screen spill or dark fringes. The original alpha is put back.\n\nUse before merging a keyed element over a new background."
 addUserKnob {20 ee l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy EdgeExtend</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Pushes clean core colour out through soft edges to kill spill and fringes.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {6 src_premult l "source is premultiplied" +STARTLINE}
 src_premult true
 addUserKnob {7 erode l "core erode" t "Pixels to shrink the matte before sampling colour. Raise it if spill or fringing still shows." R 0 20}
 erode 1
 addUserKnob {7 fill_scale l "fill scale" t "Scales every level of the fill. Lower = more local colour, higher = smoother." R 0.25 4}
 fill_scale 1
 addUserKnob {7 detail t "How strongly the finer levels win over the coarser ones. Higher keeps more structure near the edge, lower gives a smoother fill." R 1 10}
 detail 3
 addUserKnob {26 ""}
 addUserKnob {6 out_premult l "premultiply output" +STARTLINE}
 out_premult true
 addUserKnob {4 view M {Result "Core matte"}}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy EdgeExtend</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>keyed foreground (premultiplied or not)</td></tr></table><br><b>How it works</b><br>Edge extend (push-pull).<br><br>Erodes the matte to a clean core, then pushes the core&#x27;s colour outward to infinity, so semi-transparent edges carry clean foreground colour instead of screen spill or dark fringes. The original alpha is put back.<br><br>Use before merging a keyed element over a new background."}
}
