#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 inputs 2
 help "Light wrap: spills blurred background light onto the inside edges of the foreground.\n\nInputs: FG (premultiplied), BG.\nOutput is the FG with the wrap added. Merge it over the BG as usual. Use 'Wrap only' to see the light being added."
 addUserKnob {20 lw l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy LightWrap</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Wraps blurred background light onto the inside edges of the foreground.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {7 wrap_width l "wrap width" t "How far the light reaches into the foreground (pixels)." R 0 100}
 wrap_width 15
 addUserKnob {7 falloff t "Above 1 = tighter to the edge, below 1 = spreads further in." R 0.2 4}
 falloff 1
 addUserKnob {7 intensity R 0 4}
 intensity 1
 addUserKnob {26 bgsec l "<b>Background</b>"}
 addUserKnob {7 bg_blur l "bg blur" R 0 200}
 bg_blur 30
 addUserKnob {7 threshold l "highlights only" t "Only background light above this luminance wraps. 0 = all light." R 0 4}
 addUserKnob {7 saturation t "0 = luminance-only wrap." R 0 2}
 saturation 1
 addUserKnob {26 outsec l "<b>Output</b>"}
 addUserKnob {4 operation M {plus screen}}
 addUserKnob {4 view M {Result "Wrap only" "Edge matte"}}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy LightWrap</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>FG</b>&nbsp;&nbsp;</td><td>premultiplied foreground</td></tr><tr><td><b>BG</b>&nbsp;&nbsp;</td><td>background</td></tr></table><br><b>How it works</b><br>Light wrap: spills blurred background light onto the inside edges of the foreground.<br><br>Inputs: FG (premultiplied), BG.<br>Output is the FG with the wrap added. Merge it over the BG as usual. Use &#x27;Wrap only&#x27; to see the light being added."}
}
