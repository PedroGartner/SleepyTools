#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 help "Chroma key by SleepyTools. v2 merges ALPHA and ChromaKeyer.\n\nModes\n- Colour pick: Ctrl+click the key colour in the viewer. Matches colour regardless of brightness.\n- Screen difference: classic green/blue screen matte (key colour = a screen sample).\n- Saturation: keys neutral / grey areas (what ALPHA's Key 01 was doing).\n\nThe plate RGB is passed through untouched; only alpha is replaced. Black pixels no longer produce NaN/inf."
 addUserKnob {20 key l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy ChromaKey</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Colour-pick, screen-difference or saturation key. Plate RGB untouched, only alpha replaced.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {4 mode M {"Colour pick" "Screen difference" "Saturation (neutral areas)"}}
 addUserKnob {18 colour l "key colour" t "Ctrl+click on the plate in the viewer. In Screen difference mode, sample a typical area of the screen."}
 colour {0.12 0.55 0.18}
 addUserKnob {4 screen l "screen type" t "Screen difference mode only." M {Green Blue}}
 addUserKnob {26 ""}
 addUserKnob {7 tolerance t "Colour pick: how far from the key colour still counts as a full match." R 0 0.5}
 tolerance 0.05
 addUserKnob {7 softness t "Colour pick: width of the falloff after the tolerance." R 0 1}
 softness 0.25
 addUserKnob {7 dark_limit l "ignore darks below" t "Colour pick: pixels darker than this fade out of the key (the colour of dark noise is random). 0 = off." R 0 0.5}
 addUserKnob {7 preblur l "pre-blur" t "Blur used only to calculate the key, for noisy plates. The output RGB is never blurred." R 0 10}
 addUserKnob {26 matte l "<b>Matte</b>"}
 addUserKnob {41 blackpoint T MatteGrade.blackpoint}
 addUserKnob {41 whitepoint T MatteGrade.whitepoint}
 addUserKnob {41 gamma T MatteGrade.gamma}
 addUserKnob {6 binarise l "crunch (binarise)" t "Every alpha value above the threshold becomes 1, everything else 0. This is the old Fill Alpha." +STARTLINE}
 addUserKnob {7 threshold -STARTLINE}
 addUserKnob {6 invert l "invert matte" +STARTLINE}
 addUserKnob {26 output l "<b>Output</b>"}
 addUserKnob {6 premult l premultiply +STARTLINE}
 addUserKnob {4 view M {Result Matte}}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy ChromaKey</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>plate to key</td></tr></table><br><b>How it works</b><br>Chroma key by SleepyTools. v2 merges ALPHA and ChromaKeyer.<br><br>Modes<br>- Colour pick: Ctrl+click the key colour in the viewer. Matches colour regardless of brightness.<br>- Screen difference: classic green/blue screen matte (key colour = a screen sample).<br>- Saturation: keys neutral / grey areas (what ALPHA&#x27;s Key 01 was doing).<br><br>The plate RGB is passed through untouched; only alpha is replaced. Black pixels no longer produce NaN/inf."}
}
