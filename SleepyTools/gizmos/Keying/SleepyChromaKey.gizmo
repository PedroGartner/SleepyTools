 Blur {
  inputs 1
  channels rgb
  size {{parent.preblur}}
  disable {{parent.preblur==0}}
  name PreBlur
  xpos 190
  ypos 72
 }
set N_PreBlur [stack 0]
 Expression {
  inputs 1
  temp_name0 pick
  temp_expr0 "(1-clamp((sqrt((r/max(r+g+b,1e-6)-parent.colour.r/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6))*(r/max(r+g+b,1e-6)-parent.colour.r/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6))+(g/max(r+g+b,1e-6)-parent.colour.g/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6))*(g/max(r+g+b,1e-6)-parent.colour.g/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6))+(b/max(r+g+b,1e-6)-parent.colour.b/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6))*(b/max(r+g+b,1e-6)-parent.colour.b/max(parent.colour.r+parent.colour.g+parent.colour.b,1e-6)))-parent.tolerance)/max(parent.softness,1e-6)))*(parent.dark_limit>0 ? clamp((r+g+b)/(3*parent.dark_limit)) : 1)"
  temp_name1 scr
  temp_expr1 "1-clamp(parent.screen==0 ? (g-max(r,b))/max(parent.colour.g-max(parent.colour.r,parent.colour.b),1e-6) : (b-max(r,g))/max(parent.colour.b-max(parent.colour.r,parent.colour.g),1e-6))"
  temp_name2 neutral
  temp_expr2 "1-clamp((max(r,g,b)-min(r,g,b))/max(max(r,g,b),1e-6))"
  channel0 alpha
  expr0 "parent.mode==0 ? pick : parent.mode==1 ? scr : neutral"
  name Key
  xpos 190
  ypos 144
 }
set N_Key [stack 0]
