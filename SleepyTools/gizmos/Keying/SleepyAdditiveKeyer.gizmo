#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 inputs 4
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(3) is not None)\n"
 help "Additive keyer: transfers the fine detail a hard key loses (hair, smoke, motion blur, shadows) from the plate onto the new background.\n\nInputs: plate, screen (clean plate or a generated clean screen), bg, mask (optional).\nOutput: the BG with plate detail. Put your hard-keyed FG over it.\n\nAdd = BG + (plate - screen). Multiply = BG x (plate / screen), better for shadows and darker detail."
 addUserKnob {20 ak l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy AdditiveKeyer</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Transfers hair, smoke, blur and shadow detail from the plate onto the new background.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {4 method M {"Add (plate - screen)" "Multiply (plate / screen)"}}
 addUserKnob {7 amount R 0 2}
 amount 1
 addUserKnob {7 det_sat l "detail saturation" t "0 = luminance only (usual), 1 = full colour (brings screen colour back)." R 0 1}
 addUserKnob {7 det_blur l "detail blur" t "Softens the detail to hide noise and grain differences." R 0 5}
 addUserKnob {4 polarity l "add mode" t "Add method only." M {Both "Brighten only" "Darken only"}}
 addUserKnob {26 ""}
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {4 view M {Result Detail}}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy AdditiveKeyer</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>plate</b>&nbsp;&nbsp;</td><td>original plate</td></tr><tr><td><b>screen</b>&nbsp;&nbsp;</td><td>clean plate / clean screen</td></tr><tr><td><b>bg</b>&nbsp;&nbsp;</td><td>new background</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>optional: limit the effect</td></tr></table><br><b>How it works</b><br>Additive keyer: transfers the fine detail a hard key loses (hair, smoke, motion blur, shadows) from the plate onto the new background.<br><br>Inputs: plate, screen (clean plate or a generated clean screen), bg, mask (optional).<br>Output: the BG with plate detail. Put your hard-keyed FG over it.<br><br>Add = BG + (plate - screen). Multiply = BG x (plate / screen), better for shadows and darker detail."}
}
