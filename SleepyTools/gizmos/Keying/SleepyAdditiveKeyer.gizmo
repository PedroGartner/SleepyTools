 Expression {
  inputs 1
  expr0 "parent.method==0 ? (parent.polarity==1 ? max(((0.2126*r+0.7152*g+0.0722*b)+(r-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : parent.polarity==2 ? min(((0.2126*r+0.7152*g+0.0722*b)+(r-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : ((0.2126*r+0.7152*g+0.0722*b)+(r-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat))*parent.amount : 1+(((0.2126*r+0.7152*g+0.0722*b)+(r-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat)-1)*parent.amount"
  expr1 "parent.method==0 ? (parent.polarity==1 ? max(((0.2126*r+0.7152*g+0.0722*b)+(g-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : parent.polarity==2 ? min(((0.2126*r+0.7152*g+0.0722*b)+(g-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : ((0.2126*r+0.7152*g+0.0722*b)+(g-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat))*parent.amount : 1+(((0.2126*r+0.7152*g+0.0722*b)+(g-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat)-1)*parent.amount"
  expr2 "parent.method==0 ? (parent.polarity==1 ? max(((0.2126*r+0.7152*g+0.0722*b)+(b-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : parent.polarity==2 ? min(((0.2126*r+0.7152*g+0.0722*b)+(b-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat),0) : ((0.2126*r+0.7152*g+0.0722*b)+(b-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat))*parent.amount : 1+(((0.2126*r+0.7152*g+0.0722*b)+(b-(0.2126*r+0.7152*g+0.0722*b))*parent.det_sat)-1)*parent.amount"
  name Shape
  xpos 330
  ypos 216
 }
