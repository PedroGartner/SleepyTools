#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 inputs 3
 help "Pulls the background's colour into the foreground edges while keeping the foreground's brightness.\n\nv2: colour is blended as a chroma vector instead of in HSV, so reds and magentas no longer flip hue at the wrap point, and FG luminance is preserved exactly. 'view edge mask' shows where it acts."
 addUserKnob {20 User l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Smoosh Colours</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Pulls the background&#x27;s colour into the foreground edges, keeping FG brightness.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {26 edge l "<b>Edge</b>"}
 addUserKnob {41 erodesize l "Edge Detect Size" T EdgeDetect1.erodesize}
 addUserKnob {41 edge_blur l "Edge Detect Softness" T Blur6.size}
 addUserKnob {6 usealpha l "use Alpha input" t "Off: edges come from the FG alpha.\nOn: edges come from the Alpha input." +STARTLINE}
 addUserKnob {26 bg l "<b>Background</b>"}
 addUserKnob {41 blur_bg l "Blur Background" T Blur5.size}
 addUserKnob {26 mix l "<b>Mixer Controls</b>"}
 addUserKnob {7 hue_mix l "Hue Mix" t "How much of the background hue to take (0 = FG hue, 1 = BG hue)."}
 hue_mix 1
 addUserKnob {7 sat_mix l "Saturation Mix" t "How much of the background saturation to take."}
 sat_mix 0.63
 addUserKnob {41 amount l Amount T Keymix2.mix}
 addUserKnob {6 view_edge l "view edge mask" +STARTLINE}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Smoosh Colours</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>FG</b>&nbsp;&nbsp;</td><td>foreground</td></tr><tr><td><b>BG</b>&nbsp;&nbsp;</td><td>background</td></tr><tr><td><b>Alpha</b>&nbsp;&nbsp;</td><td>optional edge matte</td></tr></table><br><b>How it works</b><br>Pulls the background&#x27;s colour into the foreground edges while keeping the foreground&#x27;s brightness.<br><br>v2: colour is blended as a chroma vector instead of in HSV, so reds and magentas no longer flip hue at the wrap point, and FG luminance is preserved exactly. &#x27;view edge mask&#x27; shows where it acts."}
}
