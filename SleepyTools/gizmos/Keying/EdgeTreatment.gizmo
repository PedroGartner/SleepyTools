 OFXuk.co.thefoundry.keylight.keylight_v201 {
  inputs 1
  show "Intermediate Result"
  unPreMultiply false
  screenColour {0.1 0.6 0.15}
  screenGain 1
  screenBalance 0.5
  alphaBias {0.05427400023 0.02726599947 0.01625199988}
  despillBias {0.5 0.5 0.5}
  gangBiases false
  preBlur 0
  "Screen Matte" 0
  screenClipMin 0
