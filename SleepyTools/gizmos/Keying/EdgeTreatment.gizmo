#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x3f9e5aff
 inputs 2
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(1) is not None)\n"
 help "Edge despill with luminance restore.\n\nKeylight removes the screen spill from SOURCE (despill only, no premultiply). The brightness that the despill took away is added back as neutral (or tinted) light, so edges don't go dark or grey. Connect MASK to limit it to an edge region; without a mask it works on the whole frame.\n\nv2: rebuilt; the old version went black inside the mask because Keylight's Final Result is premultiplied."
 addUserKnob {20 despill l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">EdgeTreatment</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying</font><br><font color=\"#a8a8a8\">Edge despill with luminance restore, optionally limited to an edge mask.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {41 screenColour l "Screen Colour" T Keylight5.screenColour}
 addUserKnob {41 screenGain l "Screen Gain" T Keylight5.screenGain}
 addUserKnob {41 screenBalance l "Screen Balance" T Keylight5.screenBalance}
 addUserKnob {41 despillBias l "Despill Bias" T Keylight5.despillBias}
 addUserKnob {26 ""}
 addUserKnob {7 restore l "restore luminance" t "How much of the brightness removed by the despill is added back." R 0 2}
 restore 1
 addUserKnob {18 restore_colour l "restore colour" t "Tint of the restored light. Pick the background colour for a light-wrap feel."}
 restore_colour {1 1 1}
 addUserKnob {26 ""}
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {4 view M {Result "Removed spill"}}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">EdgeTreatment</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Keying &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>SOURCE</b>&nbsp;&nbsp;</td><td>plate / keyed element</td></tr><tr><td><b>MASK</b>&nbsp;&nbsp;</td><td>optional: edge region</td></tr></table><br><b>How it works</b><br>Edge despill with luminance restore.<br><br>Keylight removes the screen spill from SOURCE (despill only, no premultiply). The brightness that the despill took away is added back as neutral (or tinted) light, so edges don&#x27;t go dark or grey. Connect MASK to limit it to an edge region; without a mask it works on the whole frame.<br><br>v2: rebuilt; the old version went black inside the mask because Keylight&#x27;s Final Result is premultiplied."}
}
