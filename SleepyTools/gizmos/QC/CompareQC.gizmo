#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0xb04a4aff
 inputs 2
 help "Compare two images. By Sean Danischevsky 2004...2011...2015...\nv2: heatmap mode (red = changed more than the threshold), 'Don't set' range option works, empty menu entries removed."
 label "Range: \[value FrameRange1.first_frame]-\[value FrameRange1.last_frame]"
 addUserKnob {20 Compare_sd l "Controls" t "by Sean Danischevsky 2017"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">CompareQC</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; QC</font><br><font color=\"#a8a8a8\">Difference, emboss, anaglyph or heatmap comparison of two images.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {4 range t "Output frame range: overlap of both inputs (Min), union (Max), or leave it alone." M {Min Max "Don't set"}}
 addUserKnob {4 method M {difference emboss anaglyph heatmap}}
 addUserKnob {20 differencegrade l "difference grade" n 1}
 addUserKnob {41 gamma_1 l gamma T GradeGamma1.gamma}
 addUserKnob {41 white_1 l gain T GradeExposure1.white}
 addUserKnob {20 endGroup n -1}
 addUserKnob {20 embossgrade l "emboss grade" n 1}
 addUserKnob {41 gamma T GradeGamma.gamma}
 addUserKnob {41 white l gain T GradeExposure.white}
 addUserKnob {20 endGroup_1 l endGroup n -1}
 addUserKnob {20 heatmapgrp l heatmap n 1}
 addUserKnob {7 threshold t "Pixels that differ by more than this (in any channel) turn red." R 0 0.1}
 threshold 0.002
 addUserKnob {7 dim l "background brightness"}
 dim 0.3
 addUserKnob {20 endGroup_2 l endGroup n -1}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">CompareQC</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; QC &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>image A</td></tr><tr><td><b>Input2</b>&nbsp;&nbsp;</td><td>image B</td></tr></table><br><b>How it works</b><br>Compare two images. By Sean Danischevsky 2004...2011...2015...<br>v2: heatmap mode (red = changed more than the threshold), &#x27;Don&#x27;t set&#x27; range option works, empty menu entries removed."}
}
