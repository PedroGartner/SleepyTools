 Expression {
  inputs 1
  temp_name0 dx
  temp_expr0 "r-parent.centre.r"
  temp_name1 dy
  temp_expr1 "g-parent.centre.g"
  temp_name2 dz
  temp_expr2 "b-parent.centre.b"
  expr0 "((dx*cos((parent.rotate.z*pi/180))+dy*sin((parent.rotate.z*pi/180)))*cos((parent.rotate.y*pi/180))-dz*sin((parent.rotate.y*pi/180)))/max((parent.uniform*parent.scale.x),1e-6)"
  expr1 "((-dx*sin((parent.rotate.z*pi/180))+dy*cos((parent.rotate.z*pi/180)))*cos((parent.rotate.x*pi/180))+((dx*cos((parent.rotate.z*pi/180))+dy*sin((parent.rotate.z*pi/180)))*sin((parent.rotate.y*pi/180))+dz*cos((parent.rotate.y*pi/180)))*sin((parent.rotate.x*pi/180)))/max((parent.uniform*parent.scale.y),1e-6)"
  expr2 "(-(-dx*sin((parent.rotate.z*pi/180))+dy*cos((parent.rotate.z*pi/180)))*sin((parent.rotate.x*pi/180))+((dx*cos((parent.rotate.z*pi/180))+dy*sin((parent.rotate.z*pi/180)))*sin((parent.rotate.y*pi/180))+dz*cos((parent.rotate.y*pi/180)))*cos((parent.rotate.x*pi/180)))/max((parent.uniform*parent.scale.z),1e-6)"
  name Local
  xpos 190
  ypos 144
 }
set N_Local [stack 0]
 Expression {
  inputs 1
  channel0 alpha
  expr0 "parent.invert ? 1-clamp((1-(parent.shape==0 ? sqrt(r*r+g*g+b*b) : max(abs(r),abs(g),abs(b))))/max(parent.falloff,1e-6)) : clamp((1-(parent.shape==0 ? sqrt(r*r+g*g+b*b) : max(abs(r),abs(g),abs(b))))/max(parent.falloff,1e-6))"
  name Matte
  xpos 190
  ypos 216
 }
