#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x7d62b8ff
 help "Position matte: a soft sphere or box matte from a world-position (P) pass.\n\n1. Pick the P layer.\n2. Set view to 'Position pass' and Ctrl+click the centre colour knob on the spot you want.\n3. Size, rotate and soften. The matte is written into the channel chosen under 'write matte to'."
 addUserKnob {20 pm l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy PMatte</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; CG</font><br><font color=\"#a8a8a8\">Soft sphere or box matte from a world-position pass.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {41 in1 l "P layer" T Shuf_P.in1}
 addUserKnob {4 shape M {Sphere Box}}
 addUserKnob {18 centre l "centre (Ctrl+click on P)" t "Switch view to Position pass, then Ctrl+click here and on the image to sample the world position."}
 centre {0 0 0}
 addUserKnob {7 uniform l "uniform size" R 0.01 100}
 uniform 1
 addUserKnob {13 scale l size}
 scale {1 1 1}
 addUserKnob {13 rotate}
 addUserKnob {7 falloff t "Soft border as a fraction of the size. 0 = hard edge." R 0 1}
 falloff 0.3
 addUserKnob {6 invert +STARTLINE}
 addUserKnob {26 ""}
 addUserKnob {41 to0 l "write matte to" T CopyMatte.to0}
 addUserKnob {4 view M {Result Matte "Position pass"}}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy PMatte</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; CG &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>cg</b>&nbsp;&nbsp;</td><td>CG render with a P (position) layer</td></tr></table><br><b>How it works</b><br>Position matte: a soft sphere or box matte from a world-position (P) pass.<br><br>1. Pick the P layer.<br>2. Set view to &#x27;Position pass&#x27; and Ctrl+click the centre colour knob on the spot you want.<br>3. Size, rotate and soften. The matte is written into the channel chosen under &#x27;write matte to&#x27;."}
}
