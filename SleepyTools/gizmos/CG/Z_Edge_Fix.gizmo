#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x7d62b8ff
 inputs 3
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(2) is not None)\n"
 addUserKnob {20 options l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Z Edge Fix</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; CG</font><br><font color=\"#a8a8a8\">Extends depth values past the alpha edge so ZDefocus has no halos.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {41 from0 l "depth from" t "Channel holding depth on the Z input. rgba.red = old behaviour (depth shuffled into rgb). Pick depth.Z to plug CG in directly." T DepthIn.from0}
 addUserKnob {7 growedge l "grow edge" t "Grows the outer edge values of the Z pass using an edge extend.\n\nKeep it as low as possible." R 0 20}
 growedge 1
 addUserKnob {7 samplearea l "refine sample area" t "Growing the edge can leave small black artifacts around the original edge. Lower this to remove them.\n\nKeep it as close to 0 as possible." R -10 0}
 samplearea -0.5
 addUserKnob {26 text_1 l "<b>Mask</b>"}
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {6 invert t "Masked areas are excluded from the fix by default.\nTick invert to apply the fix only inside the mask." -STARTLINE}
 addUserKnob {26 text_2 l "<b>Output</b>"}
 addUserKnob {4 out_mode l "write to" M {"rgb (as before)" "depth.Z of the Z input"}}
 addUserKnob {20 info l "Info"}
 addUserKnob {26 _1 l "" +STARTLINE T "Made for single objects. It won't work on a full CG scene\nwith one combined depth channel for everything.\n\n1. Connect the Z input (depth in rgb, or pick depth.Z above)\n2. Connect the alpha input with the CG alpha\n"}
 addUserKnob {26 text l "" +STARTLINE T "<span style=\"color:#aaa;font-family:sans-serif;font-size:7pt\">node created by <b><span style=\"color:#aaaa00\">Johannes Kretschmer</span></b> - v1.0 2022. v2 changes: depth channel choice, write-back to depth.Z, mask switch."}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Z Edge Fix</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; CG &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Z</b>&nbsp;&nbsp;</td><td>depth pass (or CG with depth.Z)</td></tr><tr><td><b>alpha</b>&nbsp;&nbsp;</td><td>CG alpha</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>optional: exclude areas</td></tr></table><br><b>How it works</b><br>"}
}
