#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x7d62b8ff
 help "Rebuild and grade up to 8 light AOVs in one node.\n\nPick a layer per slot, give it a gain, or mute it. 'Result' keeps the beauty and only adds the changes you made (beauty - original slots + graded slots), so anything you didn't pick stays exactly as rendered.\n'Difference' shows beauty minus the plain sum of the slots: if your slots are all the light AOVs it should be black, which checks the AOVs add up to the beauty."
 addUserKnob {20 ar l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy AOVRebuild</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; CG</font><br><font color=\"#a8a8a8\">Grade or mute up to 8 light AOVs and check that they add up to the beauty.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {41 aov_1 l "AOV 1" T Shuf_1.in1}
 addUserKnob {6 mute_1 l mute -STARTLINE}
 addUserKnob {41 gain_1 l gain T Grade_1.white}
 addUserKnob {41 aov_2 l "AOV 2" T Shuf_2.in1}
 addUserKnob {6 mute_2 l mute -STARTLINE}
 addUserKnob {41 gain_2 l gain T Grade_2.white}
 addUserKnob {41 aov_3 l "AOV 3" T Shuf_3.in1}
 addUserKnob {6 mute_3 l mute -STARTLINE}
 addUserKnob {41 gain_3 l gain T Grade_3.white}
 addUserKnob {41 aov_4 l "AOV 4" T Shuf_4.in1}
 addUserKnob {6 mute_4 l mute -STARTLINE}
 addUserKnob {41 gain_4 l gain T Grade_4.white}
 addUserKnob {41 aov_5 l "AOV 5" T Shuf_5.in1}
 addUserKnob {6 mute_5 l mute -STARTLINE}
 addUserKnob {41 gain_5 l gain T Grade_5.white}
 addUserKnob {41 aov_6 l "AOV 6" T Shuf_6.in1}
 addUserKnob {6 mute_6 l mute -STARTLINE}
 addUserKnob {41 gain_6 l gain T Grade_6.white}
 addUserKnob {41 aov_7 l "AOV 7" T Shuf_7.in1}
 addUserKnob {6 mute_7 l mute -STARTLINE}
 addUserKnob {41 gain_7 l gain T Grade_7.white}
 addUserKnob {41 aov_8 l "AOV 8" T Shuf_8.in1}
 addUserKnob {6 mute_8 l mute -STARTLINE}
 addUserKnob {41 gain_8 l gain T Grade_8.white}
 addUserKnob {20 vw l "View"}
 addUserKnob {4 view M {"Result (beauty + changes)" "Rebuild (sum of slots)" "Difference (beauty - sum)" "Solo slot"}}
 addUserKnob {7 diff_gain l "difference gain" R 1 100}
 diff_gain 10
 addUserKnob {3 solo_slot l "solo slot"}
 solo_slot 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy AOVRebuild</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; CG &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>cg</b>&nbsp;&nbsp;</td><td>CG render with AOV layers</td></tr></table><br><b>How it works</b><br>Rebuild and grade up to 8 light AOVs in one node.<br><br>Pick a layer per slot, give it a gain, or mute it. &#x27;Result&#x27; keeps the beauty and only adds the changes you made (beauty - original slots + graded slots), so anything you didn&#x27;t pick stays exactly as rendered.<br>&#x27;Difference&#x27; shows beauty minus the plain sum of the slots: if your slots are all the light AOVs it should be black, which checks the AOVs add up to the beauty."}
}
