#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x4f7fb5ff
 inputs 2
 help "Fills a masked hole in a plate with the surrounding colour (push-pull), then adds real plate grain copied from a nearby area.\n\nInputs: plate, mask (alpha = area to remove).\n\nGood for rig/marker removal and as a base for paint. Set 'grain offset' so it points at a clean area of the plate."
 addUserKnob {20 pf l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy PlateFill</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Cleanup</font><br><font color=\"#a8a8a8\">Fills a masked hole with surrounding colour and borrows real grain from nearby.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {7 grow l "grow mask" t "Expands the mask before filling, so the fill starts outside any soft edge of the object." R 0 20}
 grow 2
 addUserKnob {7 softness l "edge softness" t "Blur of the mask used to blend the fill back in." R 0 20}
 softness 2
 addUserKnob {7 fill_scale l "fill scale" t "Scales every level of the fill. Lower = more local colour, higher = smoother." R 0.25 4}
 fill_scale 1
 addUserKnob {7 detail t "How strongly the finer levels win over the coarser ones. Higher keeps more structure near the edge, lower gives a smoother fill." R 1 10}
 detail 3
 addUserKnob {26 grain l "<b>Grain</b>"}
 addUserKnob {7 regrain l "regrain amount" R 0 2}
 regrain 1
 addUserKnob {7 grain_size l "grain size" t "Blur used to separate grain from detail." R 0.5 5}
 grain_size 1.5
 addUserKnob {12 grain_offset l "grain offset" t "Where to borrow grain from, relative to the hole (pixels). Point it at a clean, flat area."}
 grain_offset {150 0}
 addUserKnob {4 view M {Result "Fill only" Mask}}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy PlateFill</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Cleanup &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>plate</b>&nbsp;&nbsp;</td><td>plate</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>area to remove (alpha)</td></tr></table><br><b>How it works</b><br>Fills a masked hole in a plate with the surrounding colour (push-pull), then adds real plate grain copied from a nearby area.<br><br>Inputs: plate, mask (alpha = area to remove).<br><br>Good for rig/marker removal and as a base for paint. Set &#x27;grain offset&#x27; so it points at a clean area of the plate."}
}
