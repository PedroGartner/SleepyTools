#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x4f7fb5ff
 inputs 2
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(1) is not None)\n"
 help "Temporal median: for every pixel, takes the median of the surrounding frames. Removes rain, dust, flicker spikes and things that pass through a locked-off (or stabilised) shot.\n\nExact median of 3 or 5 frames. 'frame step' spaces the samples further apart for slower-moving objects. Optional mask limits it to an area."
 addUserKnob {20 tm l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">Sleepy TemporalMedian</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Cleanup</font><br><font color=\"#a8a8a8\">Exact median of 3 or 5 frames to remove rain, dust and passers-by.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {4 frames M {"3 frames" "5 frames"}}
 frames "5 frames"
 addUserKnob {3 step l "frame step" t "Distance between sampled frames."}
 step 1
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {26 sleepy_mix_div l "" +STARTLINE}
 addUserKnob {7 mix t "Blend between the untouched input (0) and the result (1)."}
 mix 1
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">Sleepy TemporalMedian</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v1.0 &middot; Cleanup &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>locked-off or stabilised plate</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>optional: limit the effect</td></tr></table><br><b>How it works</b><br>Temporal median: for every pixel, takes the median of the surrounding frames. Removes rain, dust, flicker spikes and things that pass through a locked-off (or stabilised) shot.<br><br>Exact median of 3 or 5 frames. &#x27;frame step&#x27; spaces the samples further apart for slower-moving objects. Optional mask limits it to an area."}
}
