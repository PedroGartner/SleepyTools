#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x9a7a4fff
 inputs 2
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['compare'].setValue(n.input(1) is not None)\n"
 help "Shows the grain (high-pass) of the image. v2: centred display so negative grain is visible, channel isolation, optional plate input for a plate / comp split."
 addUserKnob {20 User l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">GrainChecker</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Grain</font><br><font color=\"#a8a8a8\">Shows the grain (high-pass), with an optional plate / comp split.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {7 adjustgrain l "Adjust Grain Visibility" t "Gain applied to the grain for viewing." R 0 50}
 adjustgrain 10
 addUserKnob {7 grain_size l "grain size" t "Blur used to separate grain from image detail." R 0.5 5}
 grain_size 2
 addUserKnob {6 use_log l "measure in log" t "Converts to log first so shadow and highlight grain read at similar strength." +STARTLINE}
 use_log true
 addUserKnob {4 display M {"centred (grey = no grain)" absolute}}
 addUserKnob {4 channel M {RGB Red Green Blue}}
 addUserKnob {26 cmp l "<b>Compare</b>"}
 addUserKnob {6 compare l "split plate / comp" t "Left of the split: plate input. Right: this node's main input. Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {7 split l "split position"}
 split 0.5
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">GrainChecker</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Grain &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>Input1</b>&nbsp;&nbsp;</td><td>image to check</td></tr><tr><td><b>plate</b>&nbsp;&nbsp;</td><td>optional: plate for the split view</td></tr></table><br><b>How it works</b><br>Shows the grain (high-pass) of the image. v2: centred display so negative grain is visible, channel isolation, optional plate input for a plate / comp split."}
}
