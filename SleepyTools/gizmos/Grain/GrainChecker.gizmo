 MergeExpression {
  inputs 2
  expr0 "abs(x+0.5-width*parent.split)<1.5 ? 1 : (x+0.5<width*parent.split ? Ar : Br)"
  expr1 "abs(x+0.5-width*parent.split)<1.5 ? 1 : (x+0.5<width*parent.split ? Ag : Bg)"
  expr2 "abs(x+0.5-width*parent.split)<1.5 ? 1 : (x+0.5<width*parent.split ? Ab : Bb)"
  expr3 Ba
  disable {{!parent.compare}}
  name Split
  xpos 710
  ypos 288
 }
set N_Split [stack 0]
 Expression {
  inputs 1
  expr0 "(parent.display==0 ? (parent.channel==0 ? r : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain+0.5 : abs(parent.channel==0 ? r : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain)"
  expr1 "(parent.display==0 ? (parent.channel==0 ? g : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain+0.5 : abs(parent.channel==0 ? g : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain)"
  expr2 "(parent.display==0 ? (parent.channel==0 ? b : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain+0.5 : abs(parent.channel==0 ? b : (parent.channel==1 ? r : parent.channel==2 ? g : b))*parent.adjustgrain)"
  name Display
  xpos 710
  ypos 360
 }
