#! C:/Program Files/Nuke13.2v4/nuke-13.2.4.dll -nx
version 13.2 v4
Gizmo {
 tile_color 0x9a7a4fff
 inputs 4
 knobChanged "k = nuke.thisKnob()\nif k.name() == 'inputChange':\n    n = nuke.thisNode()\n    n\['use_mask'].setValue(n.input(3) is not None)\n"
 help "Regrain a comp built on a denoised plate.\n\nInputs: PLATE (original), COMP (built on DENOISE), DENOISE (the denoised plate), mask (optional: only regrain here).\n\nv2: grain source menu labelled correctly, grain amount, safe divide (no NaN on black), rgb-only maths (alpha untouched), optional mask. F_ReGrain needs NukeX."
 addUserKnob {20 regrain l "Controls"}
 addUserKnob {26 sleepy_title l "" +STARTLINE T "<b><font size=\"4\">SleepyGrain</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Grain</font><br><font color=\"#a8a8a8\">Regrains a comp built on a denoised plate, with real or synthetic grain.</font>"}
 addUserKnob {26 sleepy_title_div l "" +STARTLINE}
 addUserKnob {4 pulldown l "grain source" t "Plate grain: the real grain, extracted as PLATE minus DENOISE.\nSynthetic: grain generated by F_ReGrain from a sample (use when the plate grain can't be reused, e.g. retimes or big repaints)." M {"Plate grain (extracted)" "Synthetic (F_ReGrain)"}}
 addUserKnob {7 grainAmount l "grain amount" R 0 2}
 grainAmount 1
 addUserKnob {41 which l "multiply / add" t "0 = multiplicative (grain scales with brightness), 1 = additive. Most comps sit well around 0.7-0.8. For heavy luminance changes lean multiplicative." T Dissolve1.which}
 addUserKnob {7 ratio_limit l "ratio limit" t "Caps the multiplicative grain ratio so near-black denoised pixels cannot spike." R 1 10}
 ratio_limit 4
 addUserKnob {6 use_mask l "use mask input" t "Ticks itself when you connect that input with the node panel open. Tick it by hand if Nuke did not catch the connection." +STARTLINE}
 addUserKnob {6 grainQC l "Grain QC" t "Check that seams are not visible and the regrain looks like the plate grain." +STARTLINE}
 addUserKnob {6 grainOffOn l On/Off +STARTLINE}
 grainOffOn true
 addUserKnob {20 regrain_1 l "Synthetic (F_ReGrain)"}
 addUserKnob {41 analyse l Analyse T F_ReGrain1.analyse}
 addUserKnob {41 grainColourSpace l "Grain Colour Space" T F_ReGrain1.grainColourSpace}
 addUserKnob {41 firstFrame l "sample frame" T FrameHold1.firstFrame}
 addUserKnob {41 setToCurrentFrame l "Set to Current Frame" -STARTLINE T FrameHold1.setToCurrentFrame}
 addUserKnob {20 tab l "Advanced"}
 addUserKnob {41 processRed l "Process Red" T F_ReGrain1.processRed}
 addUserKnob {41 redAmount l "Red Amount" T F_ReGrain1.redAmount}
 addUserKnob {41 redSize l "Red Size" T F_ReGrain1.redSize}
 addUserKnob {41 processGreen l "Process Green" T F_ReGrain1.processGreen}
 addUserKnob {41 greenAmount l "Green Amount" T F_ReGrain1.greenAmount}
 addUserKnob {41 greenSize l "Green Size" T F_ReGrain1.greenSize}
 addUserKnob {41 processBlue l "Process Blue" T F_ReGrain1.processBlue}
 addUserKnob {41 blueAmount l "Blue Amount" T F_ReGrain1.blueAmount}
 addUserKnob {41 blueSize l "Blue Size" T F_ReGrain1.blueSize}
 addUserKnob {20 grainResponse l "Grain Response" n 1}
 grainResponse 0
 addUserKnob {41 srcColourSpace l "Apply Grain In" T F_ReGrain1.srcColourSpace}
 addUserKnob {41 lowGain l "Low Gain" T F_ReGrain1.lowGain}
 addUserKnob {41 midGain l "Mid Gain" T F_ReGrain1.midGain}
 addUserKnob {41 highGain l "High Gain" T F_ReGrain1.highGain}
 addUserKnob {41 useResponse l "Use Sampled Response" T F_ReGrain1.useResponse}
 addUserKnob {41 responseMix l "Sampled Response Mix" T F_ReGrain1.responseMix}
 addUserKnob {41 sample l "Sample Grain Response" T F_ReGrain1.sample}
 addUserKnob {41 reset l "Reset Grain Response" T F_ReGrain1.reset}
 addUserKnob {41 drawResponse l "Draw Response" T F_ReGrain1.drawResponse}
 addUserKnob {20 grainResponseEnd l "" n -1}
 addUserKnob {20 sleepy_about l About}
 addUserKnob {26 sleepy_about_text l "" +STARTLINE T "<b><font size=\"4\">SleepyGrain</font></b>&nbsp;&nbsp;<font color=\"#8c8c8c\">v2.0 &middot; Grain &middot; SleepyTools</font><br><br><b>Inputs</b><table><tr><td><b>PLATE</b>&nbsp;&nbsp;</td><td>original plate</td></tr><tr><td><b>COMP</b>&nbsp;&nbsp;</td><td>comp built on the denoised plate</td></tr><tr><td><b>DENOISE</b>&nbsp;&nbsp;</td><td>denoised plate</td></tr><tr><td><b>mask</b>&nbsp;&nbsp;</td><td>optional: only regrain here</td></tr></table><br><b>How it works</b><br>Regrain a comp built on a denoised plate.<br><br>Inputs: PLATE (original), COMP (built on DENOISE), DENOISE (the denoised plate), mask (optional: only regrain here).<br><br>v2: grain source menu labelled correctly, grain amount, safe divide (no NaN on black), rgb-only maths (alpha untouched), optional mask. F_ReGrain needs NukeX."}
}
