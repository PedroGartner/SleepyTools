kernel SleepyMedian : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessRanged2D, eEdgeClamped> src;
  Image<eWrite> dst;

param:
  int radius;
  float amount;

local:
  int r;

  void define() {
    defineParam(radius, "radius", 1);
    defineParam(amount, "amount", 1.0f);
  }

  void init() {
    r = clamp(radius, 1, 3);
    src.setRange(-r, -r, r, r);
  }

  float lum(SampleType(src) p) { return 0.2126f * p.x + 0.7152f * p.y + 0.0722f * p.z; }

  // picks the neighbour whose luminance is the median, so colours stay intact (no new colours made)
  void process(int2 pos) {
    int n = (2 * r + 1) * (2 * r + 1);
    int mid = n / 2;
    SampleType(src) best = src(0, 0);
    int idx = 0;
    for (int j = -r; j <= r; j++) {
      for (int i = -r; i <= r; i++) {
        SampleType(src) p = src(i, j);
        float lp = lum(p);
        int below = 0;
        int idx2 = 0;
        for (int jj = -r; jj <= r; jj++) {
          for (int ii = -r; ii <= r; ii++) {
            float lq = lum(src(ii, jj));
            if (lq < lp || (lq == lp && idx2 < idx)) below++;
            idx2++;
          }
        }
        if (below == mid) best = p;
        idx++;
      }
    }
    SampleType(src) c = src(0, 0);
    dst() = c + (best - c) * amount;
  }
};
