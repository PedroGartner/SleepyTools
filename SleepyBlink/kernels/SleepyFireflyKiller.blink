kernel SleepyFireflyKiller : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessRanged2D, eEdgeClamped> src;
  Image<eWrite> dst;

param:
  float threshold;
  float ratio;
  int radius;
  bool showDetected;

local:
  int r;

  void define() {
    defineParam(threshold, "threshold", 1.0f);
    defineParam(ratio, "ratio", 3.0f);
    defineParam(radius, "radius", 1);
    defineParam(showDetected, "showDetected", false);
  }

  void init() {
    r = clamp(radius, 1, 3);
    src.setRange(-r, -r, r, r);
  }

  float lum(SampleType(src) p) { return 0.2126f * p.x + 0.7152f * p.y + 0.0722f * p.z; }

  // removes isolated hot pixels (render fireflies, sensor hot spots): a pixel brighter than
  // 'threshold' and 'ratio' times brighter than every neighbour (or NaN/inf) is replaced by the neighbours' mean
  void process(int2 pos) {
    SampleType(src) c = src(0, 0);
    float4 sum = float4(0.0f);
    float mx = -1e30f;
    float n = 0.0f;
    for (int j = -r; j <= r; j++) {
      for (int i = -r; i <= r; i++) {
        if (i == 0 && j == 0) continue;
        SampleType(src) p = src(i, j);
        float lp = lum(p);
        if (!(lp == lp) || lp > 1e30f) continue;
        sum += float4(p.x, p.y, p.z, p.w);
        mx = max(mx, lp);
        n += 1.0f;
      }
    }
    float lc = lum(c);
    bool broken = !(lc == lc) || lc > 1e30f;
    bool hot = broken || (lc > threshold && lc > ratio * max(mx, 1e-6f));
    if (showDetected) dst() = hot ? float4(1.0f, 0.0f, 1.0f, 1.0f) : c * 0.25f;
    else dst() = hot ? (n > 0.0f ? sum / n : float4(0.0f)) : c;
  }
};
